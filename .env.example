# Copy to .env (never commit .env) or export in your shell.
# Placeholder names only — put real values in a local file outside git.

# Demo mode: no Ollama and no NEAR key required. Verified in this README quickstart.
PYTH_MOCK=1

# NEAR AI Cloud (https://cloud.near.ai) — leave unset while PYTH_MOCK=1
# NEARAI_API_KEY=your_near_ai_api_key_here
# NEAR_AI_API_KEY=your_near_ai_api_key_here
# NEARAI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# NEARAI_DAILY_CAP=0.25
# NEARAI_MAX_TOKENS=1500

# Optional Orbio / news path (not required for the NEAR hackathon demo)
# ORBIO_API_KEY=your_orbio_api_key_here
# ORBIO_DAILY_CAP_USD=0.25

# Bind host/port for the CRT UI
# PYTH_HOST=127.0.0.1
# PYTH_PORT=7860
